{
  "version": "1.0.0-beta.14",
  "name": "@kanvas/phoenix-rebirth",
  "description": "Client and ui kit",
  "files": [
    "dist/**/*.{js,mjs,d.ts,d.mts,css,woff2}"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./lib/*": {
      "import": {
        "types": "./dist/lib/*.d.mts",
        "default": "./dist/lib/*.mjs"
      },
      "require": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store/index.d.mts",
        "default": "./dist/store/index.mjs"
      },
      "require": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons/index.d.mts",
        "default": "./dist/icons/index.mjs"
      },
      "require": {
        "types": "./dist/icons/index.d.ts",
        "default": "./dist/icons/index.js"
      }
    },
    "./views/*": {
      "import": {
        "types": "./dist/views/*.d.mts",
        "default": "./dist/views/*.mjs"
      },
      "require": {
        "types": "./dist/views/*.d.ts",
        "default": "./dist/views/*.js"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.mts",
        "default": "./dist/hooks/index.mjs"
      },
      "require": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      }
    },
    "./hooks/*": {
      "import": {
        "types": "./dist/hooks/*.d.mts",
        "default": "./dist/hooks/*.mjs"
      },
      "require": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      }
    },
    "./ui/*": {
      "import": {
        "types": "./dist/ui/*.d.mts",
        "default": "./dist/ui/*.mjs"
      },
      "require": {
        "types": "./dist/ui/*.d.ts",
        "default": "./dist/ui/*.js"
      }
    },
    "./blocks/*": {
      "import": {
        "types": "./dist/blocks/*/index.d.mts",
        "default": "./dist/blocks/*/index.mjs"
      },
      "require": {
        "types": "./dist/blocks/*/index.d.ts",
        "default": "./dist/blocks/*/index.js"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes/types.d.mts",
        "default": "./dist/themes/types.mjs"
      },
      "require": {
        "types": "./dist/themes/types.d.ts",
        "default": "./dist/themes/types.js"
      }
    },
    "./global.css": "./dist/global.css",
    "./tour.css": "./dist/lib/tour.css",
    "./themes.css": "./dist/themes/index.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./themes/patches/*.css": "./dist/themes/patches/*.css",
    "./themes/extras.css": "./dist/themes/extras/index.css",
    "./themes/extras/*.css": "./dist/themes/extras/*.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "dist/lib/*.d.ts"
      ],
      "store": [
        "dist/store/index.d.ts"
      ],
      "icons": [
        "dist/icons/index.d.ts"
      ],
      "views/*": [
        "dist/views/*.d.ts"
      ],
      "hooks": [
        "dist/hooks/index.d.ts"
      ],
      "hooks/*": [
        "dist/hooks/*.d.ts"
      ],
      "ui/*": [
        "dist/ui/*.d.ts"
      ],
      "blocks/*": [
        "dist/blocks/*/index.d.ts"
      ],
      "themes": [
        "dist/themes/types.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsup --env.NODE_ENV production && node -e \"require('fs').copyFileSync('package.json', 'dist/package.json')\"",
    "build:themes": "node scripts/build-themes.mjs",
    "watch": "NODE_OPTIONS='--max-old-space-size=16384' tsup --watch",
    "add": "node scripts/shadcn-add.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyanvasu/phoenix-rebirth.git"
  },
  "author": "Erick Sosa",
  "contributors": [
    "Erick Sosa"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kyanvasu/phoenix-rebirth/issues"
  },
  "homepage": "https://github.com/kyanvasu/phoenix-rebirth#readme",
  "devDependencies": {
    "@tanstack/react-table": "^9.2.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cookies-next": "^6.1.1",
    "formik": "^2.4.9",
    "react": "^19.3.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "yup": "^1.7.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "driver.js": "^1.9.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.29",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.14.2",
    "react-store-js": "^1.0.0",
    "react-use": "^17.6.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  }
}
